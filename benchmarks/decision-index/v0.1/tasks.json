{
  "schema_version": "openfarm-decision-index-v0.1",
  "created_utc": "2026-10-17",
  "scientific_scope": "Independent typed decision tasks, not a causal L1→L2→L3 model",
  "status": "RESEARCH_INDEX_NOT_PUBLIC_LEADERBOARD",
  "hard_gates": [
    "independent_original_source_references",
    "rights_at_input_level",
    "frozen_source_identity_and_input_contract",
    "group_disjointness_or_named_limitation",
    "explicit_missing_and_abstention_status",
    "no_reference_in_model_state",
    "always_baseline_comparison",
    "separate_calibration_from_decision_cost",
    "report_model_input_modality_and_execution_provenance",
    "exploratory_previously_reused_tests_not_ranked_as_pristine"
  ],
  "scoring_rules": {
    "lower_is_better": [
      "Brier",
      "log_loss",
      "ordinal_mae",
      "cost_weighted_error",
      "false_escalations_per_hour"
    ],
    "risk_slice": "Report critical_case_count, undertriage_ordinal_distance and false escalation volume jointly",
    "uncertainty": "bootstrap over independent group not individual temporally correlated windows",
    "no_aggregate_leaderboard": "Do not aggregate L1/L2/L3 into one accuracy or score"
  },
